PORT=8080

DB_URL=localhost:5432
DB_NAME=springbank
DB_USERNAME=springbank
DB_PASSWORD=change-me

# HS256 signing key. Must be a 256 bits secret
JWT_SECRET=your-32-byte-secret

# Token lifetime defaults to 3600000 (1 hour).
JWT_EXPIRATION_MS=3600000

# Server-side pepper for account PINs. Must not be blank
PIN_PEPPER=replace-with-another-random-secret
